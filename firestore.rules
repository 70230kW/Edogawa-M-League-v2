rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leagues/{leagueId} {
      allow read: if isLeagueMember(leagueId);
      allow create: if isAuthenticated();
      allow update: if isLeagueOwner(leagueId);
      allow delete: if isLeagueOwner(leagueId);

      match /{subcollection}/{docId} {
        allow read, write: if isLeagueMember(leagueId);
      }

      // seasons 以下の深いパス (games, sessions, standings 等) をカバー
      match /seasons/{seasonId}/{subcollection}/{docId} {
        allow read, write: if isLeagueMember(leagueId);
      }

      // players/{playerId}/trophies/{trophyId} は2段階のサブコレクションのため明示指定
      match /players/{playerId}/trophies/{trophyId} {
        allow read, write: if isLeagueMember(leagueId);
      }

      match /timeline/{postId} {
        allow read: if isLeagueMember(leagueId);
        allow create: if isLeagueMember(leagueId);
        allow update: if isLeagueMember(leagueId);
        allow delete: if isLeagueOwner(leagueId);
      }
    }

    match /leagues/{leagueId}/invites/{inviteCode} {
      allow read: if true;  // 招待URLは公開（コード自体がトークン）
      allow write: if isLeagueOwner(leagueId);
    }

    // 招待経由での自己メンバー登録を許可
    match /leagues/{leagueId}/members/{userId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read, write: if isLeagueMember(leagueId);
    }

    function isAuthenticated() {
      return request.auth != null;
    }
    function isLeagueMember(leagueId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid));
    }
    function isLeagueOwner(leagueId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerId == request.auth.uid;
    }
  }
}
